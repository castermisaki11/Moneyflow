# MoneyFlow (v13+) — local-first build
# The app keeps all data in the browser (localStorage) — there is no server
# database, no login, and no OAuth to configure any more.

# HTTP port used by `pnpm start` (the static file server). Default: 3000
# PORT=3000

# Optional analytics (umami). Also uncomment the <script> tag in client/index.html.
# VITE_ANALYTICS_ENDPOINT=https://analytics.example.com/api/signal
# VITE_ANALYTICS_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
