# Moneyflow — copy this file to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored; this file is not, so NEVER put real secrets in it.
# Full description of every variable: docs/DEVELOPMENT.md

# ─── Required ───────────────────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL=postgres://user:pass@localhost:5432/moneyflow

# Secret used to sign JWT session cookies. The server refuses to start without it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google OAuth — there is no other way to log in.
# GOOGLE_REDIRECT_URI must match a redirect URI registered in Google Cloud Console
# exactly (scheme, host, port and path included).
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ─── Optional ───────────────────────────────────────────────────────────────
# HTTP port. Default: 3000
#PORT=3000

# development | production (set by the pnpm scripts; production serves dist/)
#NODE_ENV=production

# Google user id that gets the admin role (format: google-<user-id>).
#OWNER_OPEN_ID=google-<user-id>

# Comma-separated Google user ids that get the admin role.
#ADMIN_GOOGLE_IDS=<id1>,<id2>

# Extra origins allowed to make credentialed cross-origin requests.
# The SPA is served by this same server, so same-origin traffic needs no CORS
# and you normally do not need this. Anything else is rejected.
#ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# umami analytics. Also uncomment the <script> tag in client/index.html.
#VITE_ANALYTICS_ENDPOINT=https://analytics.example.com/api/signal
#VITE_ANALYTICS_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
